PORT=8080
JWT_SECRET=mysecret

# postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>?sslmode=<MODE>
# For Docker: use 'db' as host (Docker service name)
DB_URL=postgres://postgres:postgres@db:5432/biketracker?sslmode=disable

# For native: use 'localhost' as host
# DB_URL=postgres://postgres:postgres@localhost:5432/biketracker?sslmode=disable